{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iap": {
      "type": "string",
      "const": "0.1"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    },
    "templates": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Template"
      }
    },
    "aliases": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "iap",
    "version",
    "spec"
  ],
  "$defs": {
    "Spec": {
      "type": "object",
      "properties": {
        "specVersion": {
          "type": "number",
          "const": 0
        },
        "catalogVersion": {
          "type": "string"
        },
        "pages": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Page"
          }
        },
        "blocks": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Block"
          }
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "required": [
        "specVersion",
        "catalogVersion",
        "pages",
        "blocks",
        "sources"
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/LayoutTree"
        },
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PageParam"
          }
        },
        "intent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "prompt"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "layout"
      ]
    },
    "LayoutTree": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/LayoutNode"
          }
        }
      },
      "required": [
        "root",
        "nodes"
      ]
    },
    "LayoutNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/HtmlNode"
        },
        {
          "$ref": "#/$defs/SlotNode"
        }
      ]
    },
    "HtmlNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "html"
        },
        "tag": {
          "type": "string",
          "enum": [
            "div",
            "section",
            "header",
            "footer",
            "main",
            "aside",
            "nav",
            "article",
            "figure",
            "figcaption",
            "h1",
            "h2",
            "h3",
            "h4",
            "p",
            "span",
            "strong",
            "em",
            "small",
            "blockquote",
            "ul",
            "ol",
            "li",
            "hr",
            "img",
            "a"
          ]
        },
        "className": {
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/GridTemplate"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PathRef"
            }
          ]
        },
        "src": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PathRef"
            }
          ]
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PathRef"
            }
          ]
        },
        "href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PathRef"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible": {
          "$ref": "#/$defs/VisibilityCondition"
        }
      },
      "required": [
        "kind",
        "tag"
      ]
    },
    "GridTemplate": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string"
            },
            "sm": {
              "type": "string"
            },
            "md": {
              "type": "string"
            },
            "lg": {
              "type": "string"
            },
            "xl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rows": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string"
            },
            "sm": {
              "type": "string"
            },
            "md": {
              "type": "string"
            },
            "lg": {
              "type": "string"
            },
            "xl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "PathRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ]
    },
    "VisibilityCondition": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/PathRef"
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/VisibilityCondition"
            }
          },
          "required": [
            "not"
          ]
        },
        {
          "type": "object",
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VisibilityCondition"
              }
            }
          },
          "required": [
            "and"
          ]
        },
        {
          "type": "object",
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VisibilityCondition"
              }
            }
          },
          "required": [
            "or"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/DynamicValue"
                },
                {
                  "$ref": "#/$defs/DynamicValue"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
          ]
        }
      ]
    },
    "DynamicValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/PathRef"
        }
      ]
    },
    "SlotNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "slot"
        },
        "className": {
          "type": "string"
        },
        "grid": {
          "$ref": "#/$defs/GridTemplate"
        }
      },
      "required": [
        "kind"
      ]
    },
    "PageParam": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "description"
      ]
    },
    "Block": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "toolbar": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/BlockNode"
          }
        },
        "id": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/BlockFrame"
        },
        "inputs": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "view": {
          "type": "object",
          "properties": {
            "expr": {
              "type": "string"
            },
            "schema": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "expr",
            "schema"
          ]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FieldMeta"
          }
        },
        "ui": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "root",
        "nodes",
        "id",
        "page",
        "slot",
        "order",
        "view"
      ]
    },
    "BlockNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/HtmlNode"
        },
        {
          "$ref": "#/$defs/ComponentNode"
        }
      ]
    },
    "ComponentNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "visible": {
          "$ref": "#/$defs/VisibilityCondition"
        }
      },
      "required": [
        "type"
      ]
    },
    "Action": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "intent",
            "tool",
            "set",
            "close",
            "refresh",
            "navigate",
            "research"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "name"
      ]
    },
    "BlockFrame": {
      "type": "object",
      "properties": {
        "style": {
          "default": "card",
          "type": "string",
          "enum": [
            "card",
            "plain"
          ]
        },
        "title": {
          "default": true,
          "type": "boolean"
        },
        "sources": {
          "default": true,
          "type": "boolean"
        },
        "freshness": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "FieldMeta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "requires": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label",
        "definition"
      ]
    },
    "Source": {
      "oneOf": [
        {
          "$ref": "#/$defs/ToolSource"
        },
        {
          "$ref": "#/$defs/LocalSource"
        },
        {
          "$ref": "#/$defs/ResearchSource"
        }
      ]
    },
    "ToolSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tool"
        },
        "id": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/DynamicValue"
              },
              {
                "$ref": "#/$defs/Expr"
              }
            ]
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "normalize": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "schema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "kind",
        "id",
        "connection",
        "tool",
        "normalize",
        "schema"
      ]
    },
    "Expr": {
      "type": "object",
      "properties": {
        "expr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expr"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "researchedAt": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "citations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          }
        }
      },
      "required": [
        "researchedAt",
        "citations"
      ]
    },
    "LocalSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "local"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "kind",
        "id",
        "data"
      ]
    },
    "ResearchSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "research"
        },
        "id": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "preferSources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key": {
          "type": "string"
        },
        "schema": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "params": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataFor": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "query",
        "instructions",
        "key",
        "data",
        "provenance"
      ]
    },
    "Template": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "toolbar": {
          "type": "string"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/BlockNode"
          }
        },
        "id": {
          "type": "string"
        },
        "intentId": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "itemFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "root",
        "nodes",
        "id",
        "intentId",
        "prompt",
        "summary",
        "itemFields",
        "tools"
      ]
    }
  },
  "$id": "https://intent-ui.dev/spec/0.1/document.schema.json",
  "title": "IAP document",
  "description": "A persisted Intents and Persistence document (RFC 0003 §3)."
}
