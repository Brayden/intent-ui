          "key": "id",
          "schema": {}
        },
        "leads": {
          "kind": "tool",
          "id": "leads",
          "connection": "acme",
          "tool": "list_people",
          "args": {
            "team": "core",
            "role": "lead"
          },
          "normalize": "employees.{ \"id\": id, \"name\": full_name }",
          "key": "id",
          "schema": {}
        }
      }
    },
    "templates": [],
