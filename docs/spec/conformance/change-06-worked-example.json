              "type": "DataTable",
              "props": {
                "rows": {
                  "path": "/rows"
                },
                "rowKey": "url"
              },
              "children": [
                "c1",
                "c2"
              ],
              "action": {
                "name": "intent",
                "params": {
                  "id": "pr-details",
                  "prompt": "Show this pull request's details"
                }
              }
            },
            "c1": {
              "type": "DataColumn",
              "props": {
                "header": "Title",
                "field": "title",
                "subField": "repo"
              }
            },
            "c2": {
              "type": "DataColumn",
              "props": {
                "header": "Author",
                "field": "author"
              }
            }
          }
        }
      }
    },
    "templates": [],
    "aliases": {}
  },
  "change": {
    "baseVersion": 3,
    "summary": "Pull request details",
    "ops": [
      {
        "op": "putTemplate",
        "template": {
          "id": "tpl-pr",
          "intentId": "pr-details",
          "prompt": "Show this pull request's details",
          "summary": "Title, author and a link to the pull request.",
          "itemFields": [
            "author",
            "title",
            "url"
          ],
          "tools": [],
          "root": "d",
          "nodes": {
            "d": {
              "type": "Dialog",
              "props": {
                "title": {
                  "path": "$item/title"
                },
                "dismissLabel": "Close"
              },
              "children": [
                "by",
                "go"
              ]
            },
            "by": {
              "type": "Text",
              "props": {
                "text": {
                  "path": "$item/author"
                },
                "prefix": "Opened by ",
                "variant": "secondary"
              }
            },
            "go": {
              "type": "DialogAction",
              "props": {
                "label": "Open on GitHub"
              },
              "action": {
                "name": "navigate",
                "params": {
                  "url": {
                    "path": "$item/url"
                  }
                }
              }
            }
          }
        }
      },
      {
        "op": "setAlias",
        "intent": {
          "id": "pr-details",
          "prompt": "Show this pull request's details"
        },
        "template": "tpl-pr"
      }
    ]
  },
